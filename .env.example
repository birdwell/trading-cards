# Database Configuration (Postgres)
# Local/dev: a local Postgres, or the External Database URL of trading-cards-db on Render
# Deployed on Render: render.yaml wires DATABASE_URL from trading-cards-db
DATABASE_URL=postgresql://user:password@host:5432/trading_cards

# Server Configuration
NODE_ENV=development

# Card extraction via Vercel AI Gateway (AI Gateway API key)
AI_KEY=
GEMINI_MODEL=google/gemini-2.5-flash

# Port Configuration
BACKEND_PORT=3002
FRONTEND_PORT=3000
NEXT_PUBLIC_BACKEND_PORT=3002

# Clerk Authentication (optional — app serves pages without these)
# Create an app at https://dashboard.clerk.com
# After setting NEXT_PUBLIC_* on Render, redeploy so the client build inlines it.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
