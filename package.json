{
  "name": "trading-cards",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node scripts/setup-db.js && concurrently \"BACKEND_PORT=3002 pnpm run server\" \"PORT=${PORT:-3000} pnpm run client:start\"",
    "dev": "concurrently \"pnpm run server:dev\" \"pnpm run client:dev\"",
    "server": "tsx server/api/server.ts",
    "server:dev": "tsx --watch server/api/server.ts",
    "client:dev": "pnpm --filter client dev",
    "client:build": "pnpm --filter client build",
    "client:start": "pnpm --filter client start",
    "build": "concurrently --kill-others-on-fail -n client,server -c auto \"pnpm run client:build\" \"pnpm run typecheck\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "playwright test",
    "db:setup": "node scripts/setup-db.js",
    "db:migrate-sqlite": "tsx scripts/migrate-sqlite-to-postgres.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.31.1",
    "@trpc/client": "11.29.5",
    "@trpc/server": "11.29.5",
    "@types/node": "^22.20.5",
    "ai": "^7.0.177",
    "axios": "^1.21.1",
    "concurrently": "^10.0.7",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "playwright": "^1.65.1",
    "ts-node": "^10.9.2",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@libsql/client": "^0.18.0",
    "@playwright/test": "1.65.1",
    "@types/jest": "^30.0.0",
    "@types/pg": "^8.23.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "drizzle-kit": "0.31.11",
    "jest": "30.5.2",
    "ts-jest": "29.4.15"
  }
}
