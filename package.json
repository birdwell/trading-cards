{
  "name": "trading-cards",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "start": "node scripts/setup-db.js && concurrently \"BACKEND_PORT=3002 pnpm run server\" \"PORT=${PORT:-3000} pnpm run client:start\"",
    "dev": "concurrently \"pnpm run server:dev\" \"pnpm run client:dev\"",
    "server": "tsx server/api/server.ts",
    "server:dev": "tsx --watch server/api/server.ts",
    "client:dev": "pnpm --filter client dev",
    "client:build": "pnpm --filter client build",
    "client:start": "pnpm --filter client start",
    "build": "concurrently --kill-others-on-fail -n client,server -c auto \"pnpm run client:build\" \"pnpm run typecheck\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "db:setup": "node scripts/setup-db.js",
    "db:migrate-sqlite": "tsx scripts/migrate-sqlite-to-postgres.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.26.1",
    "@trpc/client": "11.19.0",
    "@trpc/server": "11.19.0",
    "@types/axios": "^0.9.36",
    "@types/node": "^26.6.5",
    "ai": "^7.0.150",
    "axios": "^1.20.0",
    "concurrently": "^10.0.6",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "playwright": "^1.64.1",
    "ts-node": "^10.9.2",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@libsql/client": "^0.18.0",
    "@types/jest": "^30.0.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "0.31.11",
    "jest": "30.5.2",
    "ts-jest": "29.4.15"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
